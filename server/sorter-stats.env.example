# Скопируй в /etc/sorter-stats.env, заполни и chmod 600.
# Эти переменные читает sorter_stats.py.

# Слушать только локально — наружу торчит nginx (см. nginx.conf.example).
SORTER_HOST=127.0.0.1
SORTER_PORT=8787

# Откуда можно дёргать API (origin сайта игры). Несколько — через запятую.
SORTER_ALLOW_ORIGIN=https://sorter.barinbo.im

# За nginx — доверяем X-Forwarded-For/X-Real-IP для реального IP игрока.
SORTER_TRUST_PROXY=1

# Токен для приватного /api/admin?token=… — придумай длинный случайный.
SORTER_ADMIN_TOKEN=ЗАМЕНИ_НА_ДЛИННЫЙ_СЛУЧАЙНЫЙ_ТОКЕН

# Соль для хеша IP. Если не задать — сгенерится в server/salt.secret при первом старте
# (тогда ОБЯЗАТЕЛЬНО забэкапь файл: потеряешь — все игроки «обнулятся»).
# SORTER_SALT=положи_сюда_длинную_случайную_строку

# Путь к БД (по умолчанию рядом со скриптом).
# SORTER_DB=/opt/sorter/server/stats.db
